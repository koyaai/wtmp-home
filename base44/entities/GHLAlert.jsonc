{
  "name": "GHLAlert",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "Reference to Client"
    },
    "client_name": {
      "type": "string",
      "description": "Client name for display"
    },
    "month_key": {
      "type": "string",
      "description": "YYYY-MM the alert pertains to"
    },
    "month": {
      "type": "string"
    },
    "year": {
      "type": "number"
    },
    "issue_type": {
      "type": "string",
      "enum": [
        "missed_calls",
        "unread_conversations",
        "cancelled_rescheduled",
        "integration"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "warning",
        "info"
      ]
    },
    "description": {
      "type": "string",
      "description": "Full context: actual values, threshold/comparison, MoM change, integration+error"
    },
    "resolved": {
      "type": "boolean",
      "default": false
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "client_id",
    "client_name",
    "issue_type",
    "severity",
    "description"
  ]
}