{
  "name": "MonthlyReport",
  "type": "object",
  "properties": {
    "subaccount_id": {
      "type": "string",
      "description": "Reference to Subaccount"
    },
    "subaccount_name": {
      "type": "string"
    },
    "month": {
      "type": "string",
      "description": "Month name e.g. September"
    },
    "year": {
      "type": "number"
    },
    "month_key": {
      "type": "string",
      "description": "YYYY-MM unique key for subaccount+month upsert"
    },
    "form_submissions": {
      "type": "number",
      "description": "Form submissions count (null if unavailable)"
    },
    "appointment_status_counts": {
      "type": "string",
      "description": "JSON {status: count} of appointments in the month"
    },
    "total_appointments": {
      "type": "number",
      "default": 0
    },
    "unread_conversations": {
      "type": "number",
      "description": "Unread conversations count (null if unavailable)"
    },
    "calls_missed": {
      "type": "number",
      "default": 0
    },
    "calls_missed_breakdown": {
      "type": "string",
      "description": "JSON {call_status: count} of missed calls"
    },
    "integration_status": {
      "type": "string",
      "enum": [
        "healthy",
        "issue",
        "not_available"
      ],
      "default": "not_available"
    },
    "integration_issues": {
      "type": "string",
      "description": "JSON array of integration issues"
    },
    "sync_status": {
      "type": "string",
      "enum": [
        "success",
        "failed",
        "not_available"
      ],
      "default": "not_available"
    },
    "sync_errors": {
      "type": "string"
    },
    "pulled_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "subaccount_id",
    "month_key"
  ]
}