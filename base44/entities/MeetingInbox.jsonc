{
  "name": "MeetingInbox",
  "type": "object",
  "properties": {
    "gmail_message_id": {
      "type": "string",
      "description": "Gmail message id of the Gemini notes email (dedupe key)"
    },
    "gmail_thread_id": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "meeting_title": {
      "type": "string",
      "description": "Meeting name from the subject, e.g. Meet SEO"
    },
    "team": {
      "type": "string",
      "enum": [
        "SEO",
        "PPC",
        "CS",
        "OM",
        "Web Dev",
        "Automations",
        "Social Media",
        "Will",
        "Other"
      ],
      "default": "Other",
      "description": "Team inferred from the meeting title"
    },
    "meeting_date": {
      "type": "string",
      "format": "date"
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "doc_url": {
      "type": "string",
      "description": "Notes by Gemini Google Doc"
    },
    "gmail_url": {
      "type": "string"
    },
    "source_origin": {
      "type": "string",
      "enum": [
        "google_doc",
        "email_body"
      ],
      "description": "Where source_text came from (falls back to the email when the Doc can't be read)"
    },
    "source_text": {
      "type": "string",
      "description": "Meeting notes text the matching ran on (capped)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_review",
        "routed",
        "no_client",
        "dismissed",
        "error"
      ],
      "default": "pending_review",
      "description": "pending_review = needs a CSM to confirm the client(s). no_client = AI found no client discussed (still reviewable)."
    },
    "matches": {
      "type": "array",
      "description": "AI-proposed client matches, one per client discussed. A reviewer confirms or changes the client before routing.",
      "items": {
        "type": "object",
        "properties": {
          "client_id": {
            "type": "string"
          },
          "client_name": {
            "type": "string"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "evidence": {
            "type": "string",
            "description": "Why the AI thinks this client was discussed (quote/names)"
          },
          "summary": {
            "type": "string"
          },
          "todos": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                },
                "point_person": {
                  "type": "string"
                }
              }
            }
          },
          "requests": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "red_flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "manual": {
            "type": "boolean",
            "description": "Added by a reviewer rather than the AI"
          }
        }
      }
    },
    "unmatched_mentions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Businesses/people that sounded like clients but didn't match the roster"
    },
    "routed_insight_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reviewed_by": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "error_message": {
      "type": "string"
    }
  },
  "required": [
    "gmail_message_id",
    "subject"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "leadership"
          }
        },
        {
          "user_condition": {
            "role": "team_lead"
          }
        },
        {
          "user_condition": {
            "role": "csm"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "leadership"
          }
        },
        {
          "user_condition": {
            "role": "team_lead"
          }
        },
        {
          "user_condition": {
            "role": "csm"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "leadership"
          }
        },
        {
          "user_condition": {
            "role": "team_lead"
          }
        },
        {
          "user_condition": {
            "role": "csm"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "leadership"
          }
        }
      ]
    }
  }
}