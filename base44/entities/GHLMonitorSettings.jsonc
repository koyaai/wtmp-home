{
  "name": "GHLMonitorSettings",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Singleton identifier",
      "default": "default"
    },
    "threshold_missed_calls": {
      "type": "number",
      "default": 10,
      "description": "Alert when missed calls exceed this count"
    },
    "threshold_unread_conversations": {
      "type": "number",
      "default": 10,
      "description": "Alert when unread conversations exceed this count"
    },
    "threshold_cancelled_resched_pct": {
      "type": "number",
      "default": 30,
      "description": "Alert when cancelled+rescheduled share of total appointments exceeds this % vs prior month"
    },
    "version_calendars": {
      "type": "string",
      "default": "v3"
    },
    "fallback_calendars": {
      "type": "string",
      "default": "2021-07-28"
    },
    "version_forms": {
      "type": "string",
      "default": "v3"
    },
    "fallback_forms": {
      "type": "string",
      "default": "2021-07-28"
    },
    "version_conversations": {
      "type": "string",
      "default": "v3"
    },
    "fallback_conversations": {
      "type": "string",
      "default": "2021-07-28"
    },
    "version_calls": {
      "type": "string",
      "default": "v3"
    },
    "fallback_calls": {
      "type": "string",
      "default": "2021-07-28"
    },
    "version_integrations": {
      "type": "string",
      "default": "v3"
    },
    "fallback_integrations": {
      "type": "string",
      "default": "2021-07-28"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "name"
  ]
}