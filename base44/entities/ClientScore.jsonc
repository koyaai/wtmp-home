{
  "name": "ClientScore",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "Reference to Client"
    },
    "client_name": {
      "type": "string"
    },
    "month": {
      "type": "string",
      "description": "e.g. January"
    },
    "year": {
      "type": "number"
    },
    "attended_meetings": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "F"
      ],
      "description": "Grade for attendance to monthly meetings"
    },
    "attended_meetings_notes": {
      "type": "string",
      "description": "Context notes for attendance grade"
    },
    "responsiveness": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "F"
      ],
      "description": "Grade for responsiveness to requests"
    },
    "responsiveness_notes": {
      "type": "string",
      "description": "Context notes for responsiveness grade"
    },
    "client_portal_engagement": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "F"
      ],
      "description": "Grade for client portal engagement"
    },
    "client_portal_engagement_notes": {
      "type": "string",
      "description": "Context notes for client portal engagement grade"
    },
    "project_posts_submission": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "F"
      ],
      "description": "Grade for project post submissions"
    },
    "project_posts_submission_notes": {
      "type": "string",
      "description": "Context notes for project posts grade"
    },
    "lead_handling": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "F"
      ],
      "description": "Grade for lead handling"
    },
    "lead_handling_notes": {
      "type": "string",
      "description": "Context notes for lead handling grade"
    },
    "communication_frequency": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "F"
      ],
      "description": "Grade for communication frequency"
    },
    "communication_frequency_notes": {
      "type": "string",
      "description": "Context notes for communication frequency grade"
    },
    "clarity_of_requests": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "F"
      ],
      "description": "Grade for clarity of requests"
    },
    "clarity_of_requests_notes": {
      "type": "string",
      "description": "Context notes for clarity of requests grade"
    },
    "leadboomerang_usage": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "F"
      ],
      "description": "Grade for Leadboomerang usage"
    },
    "leadboomerang_usage_notes": {
      "type": "string",
      "description": "Context notes for Leadboomerang usage grade"
    },
    "overall_grade": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "F"
      ],
      "description": "Overall client grade"
    },
    "notes": {
      "type": "string",
      "description": "CSM/CSA notes"
    },
    "roadblocks": {
      "type": "string",
      "description": "Existing roadblocks"
    },
    "author": {
      "type": "string",
      "description": "Who filled this out"
    }
  },
  "required": [
    "client_id",
    "client_name",
    "month",
    "year"
  ]
}