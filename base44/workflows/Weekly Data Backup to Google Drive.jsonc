{
  "name": "Weekly Data Backup to Google Drive",
  "description": "Exports every entity's records to Google Drive (WTMP Home Data Backups/<timestamp>/) every Sunday at 08:00 UTC (2-3 AM Central).",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * 0",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "weekly_data_backup_to_google_drive",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "backupDataToDrive",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}