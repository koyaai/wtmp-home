{
  "name": "Monthly GHL Subaccount Audit",
  "description": "Runs on the 1st of each month \u2014 audits every GHL-enabled client subaccount (per-subaccount API key), upserts a GHLMonthlyReport for the prior month, and raises contextual GHLAlerts against global/per-client thresholds.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 6 1 * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "monthly_ghl_subaccount_audit",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "ghlSubaccountAudit",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}