{
  "description": "Runs the GHL subaccount health audit on the 1st of each month, pulling metrics and generating alerts for all active subaccounts.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "monthly_ghl_audit",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_audit": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "ghlSubaccountAudit"
          },
          "then": "end",
          "x-base44": {
            "title": "Run GHL subaccount audit",
            "description": "Pull metrics & generate alerts"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 1 * *",
      "one_time_date": null,
      "timezone": "Asia/Manila",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Monthly GHL Subaccount Audit"
}