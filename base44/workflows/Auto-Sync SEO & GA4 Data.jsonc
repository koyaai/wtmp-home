{
  "name": "Auto-Sync SEO & GA4 Data",
  "description": "Runs daily and syncs GSC + GA4 data for all clients with active sync schedules, based on their configured frequency.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 22 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_sync_seo_ga4_data",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncAllClients",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "syncAllClients"
  }
}