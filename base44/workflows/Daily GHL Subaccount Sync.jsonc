{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_ghl_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "ghlSubaccountMonitor",
            "args": {
              "mode": "sync"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Sync GHL subaccounts",
            "description": "Calls + appointments"
          }
        }
      }
    ]
  },
  "description": "Daily sync of GHL calls and appointments for all active subaccounts",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 0 * * *",
      "one_time_date": null,
      "timezone": "Asia/Manila",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Daily GHL Subaccount Sync"
}