{
  "name": "Hourly Meeting Notes Ingest",
  "description": "Pulls new Gemini meeting notes from Gmail into the Meeting Inbox for CSM client verification",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "20 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "hourly_meeting_notes_ingest",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "ingestMeetingNotes",
            "args": {
              "days": 3,
              "max": 10
            }
          },
          "then": "end"
        }
      }
    ]
  }
}